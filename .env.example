# Support sync without webhook receiver (recommended):
# direct source -> target Supabase REST sync via edge worker.
TARGET_SUPABASE_URL=https://<TARGET_PROJECT_REF>.supabase.co
TARGET_SUPABASE_SERVICE_KEY=<target-service-role-key>

# Optional worker auth for invoking support-sync-outbound
SUPPORT_SYNC_SHARED_SECRET=<optional-secret>

# Optional mapping if IDs differ between source and target projects
TARGET_ORGANIZATION_ID=<optional-target-org-uuid>
TARGET_TICKET_CREATED_BY=<optional-target-operator-uuid>
TARGET_MESSAGE_AUTHOR_ID=<optional-target-operator-uuid>

# Required for one-time backfill script
SUPABASE_URL=https://<SOURCE_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional for backfill script if different from edge function env names
# TARGET_SUPABASE_URL=...
# TARGET_SUPABASE_SERVICE_KEY=...
